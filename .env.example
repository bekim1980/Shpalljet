# Frontend (Vite) — set these in Vercel Project → Settings → Environment Variables
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# Canonical production URL (used for OAuth/email redirects)
VITE_SITE_URL=https://www.shpalljet.net

# OAuth buttons (enable only after provider is configured in Supabase Dashboard)
VITE_OAUTH_GOOGLE_ENABLED=false
VITE_OAUTH_APPLE_ENABLED=false
